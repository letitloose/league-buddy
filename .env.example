# Reference copy only — do not put real credentials here.
# Copy the relevant lines into .env / .env.dev / .env.testdb and fill in
# real values (those files are gitignored).

DBHOST=db
DBPORT=3306
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=league_buddy
MYSQL_USER=leaguebuddy
MYSQL_PASSWORD=change_me

# true tears down and re-seeds the schema on boot, and (re)creates the
# default admin below. Never set this against a database with real data.
RESETDB=false

# Default admin account, created only when RESETDB=true.
LEAGUEBUDDYUSER=admin@example.com
LEAGUEBUDDYPASSWORD=change_me

# Name for the single seeded team.
TEAM_NAME=My Team

# Mailjet credentials. Leave EMAIL_USER unset to skip email sending
# entirely (signup/reset/roster-invite emails are then just skipped, not
# fatal) — useful for local dev without a Mailjet account.
# EMAIL_USER=your_mailjet_api_key
# EMAIL_PASSWORD=your_mailjet_secret_key
# EMAIL_SENDER=noreply@yourdomain.com

# Bind address for the Go HTTP server.
SITE_HOST=localhost
SITE_PORT=8080

# Public hostname used in activation/reset email links, and (in prod) as
# the nginx-proxy VIRTUAL_HOST label value.
VIRTUAL_HOST=localhost:8081

# Directory of .sql files applied on boot by the migration runner.
MIGRATION_PATH=./sql/migrations/

# --- Production-only (docker-compose.yml + nginx-compose.yml) ---
# VIRTUAL_HOST=league-buddy.example.com
# LETSENCRYPT_HOST=league-buddy.example.com
# SOFTWARE_LAST_UPDATE=   (stamped automatically by the deploy job once it's enabled)
